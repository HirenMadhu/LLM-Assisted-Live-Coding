# Ambient Experiment

# Coded by Darin Wilson
#
# The piece consists of three long loops, each of which
# plays one of two randomly selected pitches. Each note
# has different attack, release and sleep values, so that
# they move in and out of phase with each other. This can
# play for quite awhile without repeating itself :)

use_synth :{{synth_values[(0) % synth_values|length]}}
with_fx :{{effect_values[0]}}, mix: {{repeat_probs[0]}} do

  live_loop :note1 do
    play choose([:{{note_values[(0) % note_values|length]}},:{{note_values[(1) % note_values|length]}}]), attack: {{attack_values[(0) % attack_values|length]}}, release: {{release_values[(0) % release_values|length]}}
    sleep {{sleep_values[(0) % sleep_values|length]}}
  end

  live_loop :note2 do
    play choose([:{{note_values[(2) % note_values|length]}},:{{note_values[(3) % note_values|length]}}]), attack: {{attack_values[(1) % attack_values|length]}}, release: {{release_values[(1) % release_values|length]}}
    sleep {{sleep_values[(1) % sleep_values|length]}}
  end

  live_loop :note3 do
    play choose([:{{note_values[(4) % note_values|length]}}, :{{note_values[(5) % note_values|length]}}]), attack: {{attack_values[(2) % attack_values|length]}}, release: {{release_values[(2) % release_values|length]}}
    sleep {{sleep_values[(2) % sleep_values|length]}}
  end

end

 
