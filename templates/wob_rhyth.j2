# Wob Rhyth

# Coded by Sam Aaron

use_debug false

with_fx :{{effect_values[(0)% effect_values|length]}} do
  live_loop :choral do
    r = (ring {{repeat_probs[(1) % repeat_probs|length]}}, 1.0/3, 3.0/5).choose
    cue :choir, rate: r
    {{repeat_small_ints[0]}}.times do
      sample :{{sample_values[0]}}, rate: r, pan: rrand(-1, 1)
      sleep {{sleep_values[0]}}
    end
  end
end


live_loop :wub_wub do
  with_fx :{{effect_values[(1)% effect_values|length]}}, phase: {{repeat_small_ints[(1) % repeat_small_ints|length]}}, reps: {{repeat_small_ints[(2) % repeat_small_ints|length]}} do |w|
    with_fx :{{effect_values[(2)% effect_values|length]}}, mix: {{repeat_probs[0]}} do
      sample :{{sample_values[(1) % sample_values|length]}}
      sample :{{sample_values[(2) % sample_values|length]}}, rate: {{repeat_probs[(1)%repeat_probs|length]}}, amp: {{amp_values[0]}}
      sleep {{sleep_values[(1)% sleep_values|length]}}
      ## try changing the wobble's phase duration:
      # control w, phase: (ring {{repeat_probs[(2) % repeat_probs|length]}}, 1, 2).choose
    end
  end
end

 
