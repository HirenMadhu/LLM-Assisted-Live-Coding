# Blip Rhythm

# Coded by Sam Aaron

load_samples [:{{sample_values[(0)]}}, :{{sample_values[(1) % sample_values|length]}}]
use_bpm 100
use_random_seed 100

with_fx :{{effect_values[(0) % effect_values|length]}}, mix: {{repeat_probs[(0) % repeat_probs|length]}}, room: {{repeat_probs[(1) % repeat_probs|length]}} do
  with_fx :{{effect_values[(1) % effect_values|length]}}, room: {{repeat_probs[(2) % repeat_probs|length]}}, decay: 8, phase: 1, mix: {{repeat_probs[(3) % repeat_probs|length]}} do
    live_loop :blip do
      n = [:{{note_values[0]}}, :{{note_values[(1) % note_values|length]}}, :{{note_values[(2) % note_values|length]}}].choose

      with_synth :{{synth_values[(0) % synth_values|length]}} do
        with_transpose -12 do
          in_thread do
            {{repeat_small_ints[0]}}.times do
              play n, attack: {{attack_values[(0) % attack_values|length]}}, release: {{release_values[(0) % release_values|length]}}, detune: rrand(0, 0.1), cutoff: rrand(80, 120)
              sleep {{sleep_values[(0) % sleep_values|length]}}
            end
          end
        end
      end

      sleep {{sleep_values[(1) % sleep_values|length]}}

      with_synth :{{synth_values[(1) % synth_values|length]}} do
        play chord(n, :{{character_values[(0) % character_values|length]}}), amp: {{amp_values[0]}}, release: {{release_values[(2) % release_values|length]}}
      end

      sleep {{sleep_values[(2) % sleep_values|length]}}
    end
  end
end


with_fx :{{effect_values[(2) % effect_values|length]}}, room: {{repeat_probs[(4) % repeat_probs|length]}}, decay: {{repeat_small_ints[(1)%repeat_small_ints|length]}}, phase: {{repeat_probs[(5) % repeat_probs|length]}}, mix: {{repeat_probs[(6) % repeat_probs|length]}} do
  live_loop :rhythm do
    sample :{{sample_values[0]}}, amp: {{amp_values[(0)%amp_values|length]}}
    sample :{{sample_values[(1) % sample_values|length]}}, rate: [0.5, 2, 1, 4].choose * [1, 2, 3, 10].choose, amp: {{amp_values[(1)%amp_values|length]}}
    sleep {{sleep_values[(3) % sleep_values|length]}}
  end
end

 
